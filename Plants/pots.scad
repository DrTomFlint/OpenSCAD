F2=99;

r1=3.5;
z1=6;
n1=3;
s1=0.5;
y1=3;

r2=2.5;
z2=5;
n2=4;
s2=0.5;
y2=-1;


//-----------------------------------------------------------------------------------
module pots(){
  
  color("gray")
	cube([23,10,1]);
  
  for(i=[0:n1-1]){
    translate([s1+r1+i*(2*r1+s1),r1+s1+y1,0])
    cylinder(r1=0.8*r1,r2=r1,h=z1,$fn=F2);
  }
  
  for(i=[0:n2-1]){
    translate([s2+r2+i*(2*r2+s2),r2+s2+y2,0])
    cylinder(r1=0.8*r2,r2=r2,h=z2,$fn=F2);
  }
  
}

//=================================================================================

pots();

//=================================================================================
